#version 450
// Averaged normals for TotK's half-resolution lighting (runtime/vk_lightnorm.c). The game copies the G-buffer's
// normals to half size with one nearest read per pixel, so each half-size normal is one of the four full-resolution
// normals under it, and its point lights shade from that copy: normal-map detail finer than two pixels then lights up
// differently with every small camera move, a shimmer on everything those lights reach. This writes, per half-size
// pixel, the average of those of the four normals that lie on the same surface as the one the game kept, in the same
// encoding: red and green |x| and |y| of the sphere-map encoded pair, bits 1 and 0 of blue their signs; the other bits
// of blue and the alpha are the game's, from its copy.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D gnormal;     // G-buffer target 3, full resolution
layout(binding = 1) uniform sampler2D lin_depth;   // G-buffer linear depth, full resolution
layout(binding = 2) uniform sampler2D game_half;   // the game's half-size copy
layout(binding = 3, rgba8) uniform writeonly image2D out_half;

layout(push_constant) uniform Params {
    ivec4 size;   // half-size width, height; full width, height
} pc;

// The signed encoded pair of a stored normal
vec2 enc_of(vec4 t) {
    uint b = uint(t.z * 255.0 + 0.5);
    return t.xy * vec2((b & 2u) != 0u ? 1.0 : -1.0, (b & 1u) != 0u ? 1.0 : -1.0);
}

// Sphere-map decode as the game's lighting does it: f = |e|^2, n.xy = 2e sqrt(1 - f), n.z = 1 - 2f
vec3 decode(vec2 e) {
    float f = dot(e, e);
    return vec3(2.0 * e * sqrt(max(0.0, 1.0 - f)), 1.0 - 2.0 * f);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) return;
    vec4 g = texelFetch(game_half, p, 0);
    vec4 t[4];
    float z[4];
    int kept = 3;   // which of the four the game kept: the one whose bytes it copied
    for (int i = 0; i < 4; i++) {
        ivec2 q = min(p * 2 + ivec2(i & 1, i >> 1), pc.size.zw - 1);
        t[i] = texelFetch(gnormal, q, 0);
        z[i] = texelFetch(lin_depth, q, 0).x;
        if (all(lessThan(abs(t[i] - g), vec4(0.5 / 255.0)))) kept = i;
    }
    // only normals of the same surface: across a silhouette the kept pixel's depth, which the lighting also uses,
    // belongs to one side
    float zk = z[kept];
    vec3 n = vec3(0.0);
    for (int i = 0; i < 4; i++)
        if (abs(z[i] - zk) <= 0.03 * zk) n += decode(enc_of(t[i]));
    if (dot(n, n) < 1e-8) {
        imageStore(out_half, p, g);
        return;
    }
    n = normalize(n);
    float f = clamp((1.0 - n.z) * 0.5, 0.0, 1.0);
    vec2 e = f < 0.9999 ? n.xy / (2.0 * sqrt(1.0 - f)) : vec2(0.0);
    uint b = (uint(g.z * 255.0 + 0.5) & 252u) | (e.x >= 0.0 ? 2u : 0u) | (e.y >= 0.0 ? 1u : 0u);
    imageStore(out_half, p, vec4(min(abs(e), vec2(1.0)), float(b) / 255.0, g.w));
}
