#version 450
// SMAA pass 2 (vk_aa.c): blending weights from the edges, SMAA's area texture and its search texture (point-sampled).
#extension GL_GOOGLE_include_directive : require
#define SMAA_INCLUDE_VS 1
#define SMAA_INCLUDE_PS 1
#include "smaa_common.glsl"
layout(binding = 0) uniform sampler2D edgesTex;
layout(binding = 1) uniform sampler2D areaTex;
layout(binding = 2) uniform sampler2D searchTex;
layout(binding = 3, rgba8) uniform writeonly image2D weights;

void main() {
    vec2 uv;
    ivec2 p = smaa_pixel(uv);
    if (p.x < 0) return;
    vec2 pix;
    vec4 off[3];
    SMAABlendingWeightCalculationVS(uv, pix, off);
    imageStore(weights, p, SMAABlendingWeightCalculationPS(uv, pix, off, edgesTex, areaTex, searchTex, vec4(0.0)));
}
