#version 450
#extension GL_GOOGLE_include_directive : require
// The game's half-resolution copy of the lit scene, which the water and ice show through themselves, upsampled to the
// G-buffer's size (runtime/vk_underwater.c); upsample_common.glsl does the work.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D scene;        // half-resolution scene (R11G11B10F)
layout(set = 0, binding = 1) uniform sampler2D half_depth;   // its linear depth (R32F, same size)
layout(set = 0, binding = 2) uniform sampler2D full_depth;   // the G-buffer's linear depth (R32F)
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D dst;

layout(push_constant) uniform Params { ivec2 size; } pc;   // dst's size

#define UPSAMPLE_SRC scene
#define UPSAMPLE_DEPTH half_depth
#define UPSAMPLE_ALPHA 0
#include "upsample_common.glsl"

void main() {
    ivec2 q = ivec2(gl_GlobalInvocationID.xy);
    if (q.x >= pc.size.x || q.y >= pc.size.y) return;
    vec2 uv = (vec2(q) + 0.5) / vec2(pc.size);
    imageStore(dst, q, vec4(upsample_at(uv, texelFetch(full_depth, q, 0).x).rgb, 1.0));
}
