#version 450
// SMAA pass 3 (vk_aa.c): neighbourhood blending of the copy (sRGB view: linear light) into the game's B10G11R11 scene
// colour. A pixel without blending weights is left as the game wrote it, at full precision.
#extension GL_GOOGLE_include_directive : require
#define SMAA_INCLUDE_VS 1
#define SMAA_INCLUDE_PS 1
#include "smaa_common.glsl"
layout(binding = 0) uniform sampler2D colorTex;
layout(binding = 1) uniform sampler2D blendTex;
layout(binding = 3, r11f_g11f_b10f) uniform writeonly image2D scene;

void main() {
    vec2 uv;
    ivec2 p = smaa_pixel(uv);
    if (p.x < 0) return;
    vec4 off;
    SMAANeighborhoodBlendingVS(uv, off);
    // the weights SMAANeighborhoodBlendingPS reads: right, top, and this pixel's left and bottom
    vec4 a = vec4(textureLod(blendTex, off.xy, 0.0).a, textureLod(blendTex, off.zw, 0.0).g,
                  textureLod(blendTex, uv, 0.0).zx);
    if (dot(a, vec4(1.0)) < 1e-5) return;
    imageStore(scene, p, vec4(SMAANeighborhoodBlendingPS(uv, off, colorTex, blendTex).rgb, 1.0));
}
