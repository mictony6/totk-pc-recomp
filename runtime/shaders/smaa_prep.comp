#version 450
// SMAA input (vk_aa.c): the tonemapped scene colour (linear, 0..1 after the game's tonemap) stored sRGB-encoded in an
// RGBA8 image. Edge detection reads it through a UNORM view (gamma-space luma, as SMAA expects) and blending through
// an sRGB view (filtered in linear light).
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform Pc { vec4 rt; } pc;
layout(binding = 0) uniform sampler2D scene;
layout(binding = 3, rgba8) uniform writeonly image2D dst;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(pc.rt.zw)))) return;
    vec3 c = clamp(texelFetch(scene, p, 0).rgb, 0.0, 1.0);
    vec3 s = mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
    imageStore(dst, p, vec4(s, 1.0));
}
